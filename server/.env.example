# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Frontend Origin for CORS Allowlist
# Local Development: http://localhost:5173
# Production (Vercel): https://campusfix.vercel.app
CORS_ORIGIN=http://localhost:5173

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/campusfix

# JWT Secrets (Minimum 32 characters for production)
JWT_ACCESS_SECRET=campusfix_dev_access_secret_key_change_in_prod_12345
JWT_REFRESH_SECRET=campusfix_dev_refresh_secret_key_change_in_prod_12345

# Cloudinary Credentials (Required for image upload support)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
